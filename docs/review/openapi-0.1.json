{
  "openapi": "3.1.0",
  "info": {
    "title": "Benchmark Agents",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/evaluation-plans": {
      "post": {
        "summary": "Evaluation Plan",
        "description": "Recommend and validate scorers without invoking an agent.",
        "operationId": "evaluation_plan_v1_evaluation_plans_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Evaluation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "summary": "Submit",
        "description": "Validate configuration and enqueue a bounded local run.",
        "operationId": "submit_v1_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "summary": "Get Run",
        "description": "Read live status or persisted artifacts after restart.",
        "operationId": "get_run_v1_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}/cancel": {
      "post": {
        "summary": "Cancel",
        "description": "Stop scheduling new requests; bounded in-flight requests drain.",
        "operationId": "cancel_v1_runs__run_id__cancel_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Evaluation": {
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Description"
          },
          "samples": {
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Samples"
          },
          "scorers": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [
                    "relevance",
                    "correctness",
                    "safety",
                    "groundedness"
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scorers"
          },
          "max_scored_requests": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Max Scored Requests",
            "default": 20
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "description"
        ],
        "title": "Evaluation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Load": {
        "properties": {
          "concurrency": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Concurrency",
            "default": 5
          },
          "duration_seconds": {
            "type": "number",
            "maximum": 3600.0,
            "minimum": 0.1,
            "title": "Duration Seconds",
            "default": 30
          },
          "max_requests": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Max Requests",
            "default": 100
          },
          "timeout_seconds": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 0.1,
            "title": "Timeout Seconds",
            "default": 30
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Load"
      },
      "RunRequest": {
        "properties": {
          "target": {
            "$ref": "#/components/schemas/Target"
          },
          "evaluation": {
            "$ref": "#/components/schemas/Evaluation"
          },
          "load": {
            "$ref": "#/components/schemas/Load"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target",
          "evaluation"
        ],
        "title": "RunRequest"
      },
      "Sample": {
        "properties": {
          "inputs": {
            "additionalProperties": true,
            "type": "object",
            "title": "Inputs"
          },
          "expectations": {
            "additionalProperties": true,
            "type": "object",
            "title": "Expectations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "inputs"
        ],
        "title": "Sample"
      },
      "Target": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "adapter": {
            "type": "string",
            "enum": [
              "openai-chat",
              "mlflow-agent-server"
            ],
            "title": "Adapter",
            "default": "openai-chat"
          },
          "framework": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "langgraph",
                  "openai-agents"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Framework"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "agent"
          },
          "auth_env": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auth Env"
          },
          "auth": {
            "type": "string",
            "enum": [
              "none",
              "databricks"
            ],
            "title": "Auth",
            "default": "none"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "Target"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
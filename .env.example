# Configure once on the server; no provider keys in benchmark request bodies.
BENCHMARK_LLM_PROVIDER=databricks
DATABRICKS_CONFIG_PROFILE=YOUR_PROFILE
# Low-cost starting model; verify availability in your workspace.
BENCHMARK_PLANNER_MODEL=databricks-gpt-5-4-mini
BENCHMARK_JUDGE_MODEL=databricks-gpt-5-4-mini
# Keep evaluation artifacts local initially; FM inference still uses Databricks.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Public UI base serving the same store; never include credentials/query/fragment.
# Required for local/file and Databricks experiment links in reports.
# BENCHMARK_MLFLOW_UI_URL=http://127.0.0.1:5000
# Demo-only overrides for unknown model contracts; not benchmark target settings.
# EVALSURGE_DEMO_TOKEN_PARAMETER=max_tokens
# EVALSURGE_DEMO_REASONING_EFFORT=none
# EVALSURGE_DEMO_REQUEST_USAGE=false
# Optional correlated profiling; use the experiment ID where the agent exports traces.
# BENCHMARK_TRACE_ENABLED=true
# BENCHMARK_TRACE_EXPERIMENT_IDS='["YOUR_EXPERIMENT_ID"]'
# BENCHMARK_MAX_TRACES=100
# Trusted exact-version MLflow judges, selected by alias (not uploaded source).
# BENCHMARK_SCORERS='{"policy":{"name":"policy_accuracy","experiment_id":"YOUR_EXPERIMENT_ID","version":1,"required_fields":["inputs","outputs","expectations"],"description":"Check policy accuracy"}}'
# Optional inbound service key (required beyond loopback).
# BENCHMARK_API_KEY=replace-with-a-random-service-key
# Operator-owned exact target URL; supply connection_id=workspace in requests.
# BENCHMARK_CONNECTIONS='{"workspace":{"url":"https://YOUR-WORKSPACE.cloud.databricks.com/serving-endpoints/chat/completions","auth":"databricks"}}'

# Configure once on the server; no provider keys in benchmark request bodies.
BENCHMARK_LLM_PROVIDER=databricks
DATABRICKS_CONFIG_PROFILE=YOUR_PROFILE
# Low-cost starting model; verify availability in your workspace.
BENCHMARK_PLANNER_MODEL=databricks-gpt-5-4-mini
BENCHMARK_JUDGE_MODEL=databricks-gpt-5-4-mini
# Keep evaluation artifacts local initially; FM inference still uses Databricks.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Optional inbound service key (required beyond loopback).
# BENCHMARK_API_KEY=replace-with-a-random-service-key
# Operator-owned exact target URL; supply connection_id=workspace in requests.
# BENCHMARK_CONNECTIONS='{"workspace":{"url":"https://YOUR-WORKSPACE.cloud.databricks.com/serving-endpoints/chat/completions","auth":"databricks"}}'
